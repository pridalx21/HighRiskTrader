# Never place real credentials or control tokens in this file.
CATALYST_DEMO_ONLY=true
CATALYST_TIMEZONE=UTC
CATALYST_LOG_LEVEL=INFO
CATALYST_CONFIG_PATH=config/settings.example.toml
CATALYST_LIVE_CONFIG=config/live_runtime.example.json
CATALYST_EVENT_CSV=config/events.example.csv

# MT5 demo connection. The password is deliberately not accepted here;
# keep the demo login stored in the local MT5 terminal profile.
CATALYST_MT5_TERMINAL_PATH=
CATALYST_MT5_LOGIN=
CATALYST_MT5_SERVER=
CATALYST_MT5_SYMBOL_MAPPING_JSON=
CATALYST_MT5_ECONOMICS_JSON=

# Optional local runtime paths. Prefer .runtime/ for real local values.
CATALYST_KILL_SWITCH_PATH=.runtime/kill-switch.json
CATALYST_RISK_STATE_PATH=.runtime/risk-state.json
CATALYST_POSITION_STATE_PATH=.runtime/managed-positions.json

# Auto-demo arming factors. Leave blank in tracked examples.
CATALYST_AUTO_DEMO_CONFIRM=
CATALYST_CONTROL_TOKEN=
